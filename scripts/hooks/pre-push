#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
FRONTEND="$ROOT/frontend"
failed=0

step() { printf '\n\033[1;34m▶ %s\033[0m\n' "$1"; }
fail() { printf '\033[1;31m✗ %s\033[0m\n' "$1"; failed=1; }
pass() { printf '\033[1;32m✓ %s\033[0m\n' "$1"; }

# -- Docs --
# Check if backend/frontend model files changed without updating docs

remote="$1"
url="$2"
upstream_ref=$(git rev-parse --verify "$remote/$(git branch --show-current)" 2>/dev/null || echo "")

if [ -n "$upstream_ref" ]; then
    DIFF_RANGE="$upstream_ref..HEAD"
else
    # No upstream yet — check all commits on branch vs default branch
    base=$(git merge-base HEAD main 2>/dev/null || git merge-base HEAD master 2>/dev/null || echo "")
    if [ -n "$base" ]; then
        DIFF_RANGE="$base..HEAD"
    else
        DIFF_RANGE="HEAD~1..HEAD"
    fi
fi

changed_files=$(git diff --name-only "$DIFF_RANGE" 2>/dev/null || echo "")

model_files="custom_components/.*\.(py|ts)$|frontend/src/(lib/|controllers/|components/|eppgrid-panel\.ts|types\.ts|constants\.ts)"

if echo "$changed_files" | grep -qE "$model_files"; then
    step "Docs check"
    docs_updated=true

    if ! echo "$changed_files" | grep -q "docs/developers/data-catalog.md"; then
        printf '  ⚠  Model files changed but docs/developers/data-catalog.md not updated\n'
        docs_updated=false
    fi
    if ! echo "$changed_files" | grep -q "docs/developers/architecture.md"; then
        printf '  ⚠  Model files changed but docs/developers/architecture.md not updated\n'
        docs_updated=false
    fi

    if [ "$docs_updated" = true ]; then
        pass "Docs updated"
    else
        printf '  \033[1;33m⚠  Docs may need updating — review if the changes affect data models or architecture\033[0m\n'
    fi
fi

entity_files="custom_components/eppgrid/(sensor|binary_sensor|config_flow|__init__)\.py"
changed_entity_files=$(echo "$changed_files" | grep -E "$entity_files" || true)
if [ -n "$changed_entity_files" ]; then
    step "Strings check"
    # Only require a strings.json update when the diff actually touches lines
    # that typically correspond to strings.json entries. Touching setup or
    # wiring code in these files doesn't necessarily mean user-facing strings
    # changed.
    strings_patterns='translation_key|step_id=|reason=|vol\.(Required|Optional)\(|async_abort\(|async_show_form\('
    touches_strings=false
    for f in $changed_entity_files; do
        if git diff "$DIFF_RANGE" -- "$f" | grep -E '^[+-][^+-]' | grep -qE "$strings_patterns"; then
            touches_strings=true
            break
        fi
    done
    if [ "$touches_strings" = true ]; then
        if echo "$changed_files" | grep -q "strings.json"; then
            pass "strings.json updated"
        else
            fail "Entity/config files changed with potential new user-facing strings but strings.json not updated"
        fi
    else
        pass "No user-facing string changes detected"
    fi
fi

# -- Translations --

step "Translations check"
if python3 "$ROOT/scripts/check_translations.py" 2>&1; then
    pass "Translations validated"
else
    fail "Translations — see errors above"
fi

# -- Python --

step "Python format check"
if ruff format --check "$ROOT/custom_components/" "$ROOT/tests/" "$ROOT/firmware/" 2>&1; then
    pass "Python formatting"
else
    fail "Python formatting — run: ruff format custom_components/ tests/ firmware/"
fi

step "Python lint"
if ruff check "$ROOT/custom_components/" "$ROOT/tests/" "$ROOT/firmware/" 2>&1; then
    pass "Python lint"
else
    fail "Python lint — run: ruff check --fix custom_components/ tests/ firmware/"
fi

step "Python tests + coverage"
# Unset git env vars set by the hook context — otherwise subprocess git calls
# inside tests inherit GIT_DIR and break when they try to operate on tmp_path
# fixtures (relevant to tests/test_release_script.py).
if (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; python -m pytest "$ROOT/tests/" -x -q --cov=custom_components/eppgrid --cov-fail-under=90 2>&1); then
    pass "Python tests + coverage"
else
    fail "Python tests + coverage"
fi

# -- C++ (only if firmware code changed) --

if echo "$changed_files" | grep -q "^firmware/"; then

CPP_LIB="$ROOT/firmware/lib/epp_zone_engine"
CPP_BUILD="$CPP_LIB/build-coverage"

step "C++ build (coverage)"
# Unset git env vars set by the hook context — they break FetchContent's git clone
if (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; cmake -B "$CPP_BUILD" -S "$CPP_LIB" -DCMAKE_BUILD_TYPE=Coverage -DCMAKE_POLICY_VERSION_MINIMUM=3.5 2>&1 \
    && cmake --build "$CPP_BUILD" 2>&1); then
    pass "C++ build"
else
    fail "C++ build"
fi

step "C++ tests"
if [ "$failed" -eq 0 ] && (cd "$CPP_BUILD" && ctest --output-on-failure) 2>&1; then
    pass "C++ tests"
else
    fail "C++ tests"
fi

step "C++ coverage"
if [ "$failed" -eq 0 ] && command -v lcov >/dev/null 2>&1; then
    lcov --capture --directory "$CPP_BUILD" --output-file "$CPP_BUILD/coverage.info" \
        --ignore-errors inconsistent,format 2>&1
    lcov --extract "$CPP_BUILD/coverage.info" '*/src/*.cpp' \
        --output-file "$CPP_BUILD/coverage-filtered.info" \
        --ignore-errors unused 2>&1
    cpp_cov=$(lcov --summary "$CPP_BUILD/coverage-filtered.info" 2>&1 \
        | grep 'lines\.\.' | sed 's/.*: *\([0-9]*\.[0-9]*\)%.*/\1/')
    printf '  C++ line coverage: %s%%\n' "$cpp_cov"
    if [ "$(echo "$cpp_cov < 90" | bc)" -eq 1 ]; then
        fail "C++ coverage ${cpp_cov}% < 90%"
    else
        pass "C++ coverage ${cpp_cov}%"
    fi
elif ! command -v lcov >/dev/null 2>&1; then
    printf '  \033[1;33m⚠  lcov not installed — skipping coverage check (brew install lcov)\033[0m\n'
fi

rm -rf "$CPP_BUILD"

fi # firmware changed

# -- TypeScript --

step "TypeScript format check"
if (cd "$FRONTEND" && npx biome format src/) 2>&1; then
    pass "TypeScript formatting"
else
    fail "TypeScript formatting — run: cd frontend && npx biome format --write src/"
fi

step "TypeScript lint"
if (cd "$FRONTEND" && npx biome check src/) 2>&1; then
    pass "TypeScript lint"
else
    fail "TypeScript lint — run: cd frontend && npx biome check --fix src/"
fi

step "TypeScript build"
if (cd "$FRONTEND" && npm run build) 2>&1; then
    pass "TypeScript build"
else
    fail "TypeScript build"
fi

step "TypeScript tests + coverage"
if (cd "$FRONTEND" && npx vitest run --coverage) 2>&1; then
    pass "TypeScript tests + coverage"
else
    fail "TypeScript tests + coverage"
fi

# -- Result --

echo ""
if [ "$failed" -ne 0 ]; then
    printf '\033[1;31m✗ Pre-push checks failed. Push aborted.\033[0m\n'
    exit 1
else
    printf '\033[1;32m✓ All pre-push checks passed.\033[0m\n'
fi
